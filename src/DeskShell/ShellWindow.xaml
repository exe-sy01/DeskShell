<Window x:Class="DeskShell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tiles="clr-namespace:DeskShell.Tiles"
        Title="DeskShell"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Left="-20000" Top="-20000" Width="200" Height="200"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="Backdrop" Background="{DynamicResource DimBrush}" Opacity="0" MouseLeftButtonDown="Backdrop_MouseLeftButtonDown">
        <Grid x:Name="ShellPanel" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="ContentScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Card" Grid.Column="1" Width="1000" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20,24,20">
                <StackPanel>
                    <!-- Time and search -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="400" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ClockText" FontFamily="{StaticResource DisplayFont}" FontSize="46" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="DateText" Foreground="{DynamicResource TextDimBrush}" FontSize="15" Margin="16,8,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource SearchBox}" Tag="Search apps"
                                 VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    </Grid>

                    <!-- Tiles, or search results while typing -->
                    <Grid>
                        <tiles:TilePanel x:Name="Tiles"
                                         PreviewMouseLeftButtonDown="Tiles_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="Tiles_PreviewMouseMove"
                                         PreviewMouseLeftButtonUp="Tiles_PreviewMouseLeftButtonUp" />
                        <ListBox x:Name="Results" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                                 VerticalAlignment="Top" ItemContainerStyle="{StaticResource ResultItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseLeftButtonUp="Results_PreviewMouseLeftButtonUp"
                                 ContextMenuOpening="Results_ContextMenuOpening">
                            <ListBox.ContextMenu>
                                <ContextMenu />
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <TextBlock Text="{Binding Name}" FontSize="15" Margin="14,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="NoResults" Visibility="Collapsed" Text="No apps match that" Foreground="{DynamicResource TextDimBrush}"
                                   FontSize="14" Margin="12,10,0,0" VerticalAlignment="Top" />
                    </Grid>

                    <!-- Shown while customising -->
                    <WrapPanel x:Name="AddTilesBar" Visibility="Collapsed" Margin="0,16,0,0" />

                    <!-- Power and shell controls -->
                    <Grid Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource PillButton}" Tag="&#xE72E;" Content="Lock" Margin="0,0,8,0" Click="Lock_Click" />
                            <Button Style="{StaticResource PillButton}" Tag="&#xE708;" Content="Sleep" Margin="0,0,8,0" Click="Sleep_Click" />
                            <Button x:Name="RestartButton" Style="{StaticResource PillButton}" Tag="&#xE777;" Content="Restart" Margin="0,0,8,0" Click="Restart_Click" />
                            <Button x:Name="ShutdownButton" Style="{StaticResource PillButton}" Tag="&#xE7E8;" Content="Shut down" Click="Shutdown_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CustomiseButton" Style="{StaticResource PillButton}" Tag="&#xE70F;" Content="Customise" Margin="0,0,8,0"
                                    Click="Customise_Click" ToolTip="Move, resize, add and remove tiles" />
                            <Button Style="{StaticResource GhostButton}" Click="Overview_Click" ToolTip="Show all windows">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7C4;" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Settings_Click" ToolTip="DeskShell settings">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                            </Button>
                            <Button Style="{StaticResource GhostButton}" Click="Quit_Click" ToolTip="Quit DeskShell and bring back the Windows taskbar">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Open windows (WindowBoard): Monitor 1 on the left of the shell, Monitor 2 on the right -->
            <ContentControl x:Name="LeftHost" Grid.Column="0" Focusable="False" VerticalAlignment="Center" />
            <ContentControl x:Name="RightHost" Grid.Column="2" Focusable="False" VerticalAlignment="Center" />

            <TextBlock x:Name="HintText" Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="White" Opacity="0.75" FontSize="12" />
        </Grid>
    </Grid>
</Window>
