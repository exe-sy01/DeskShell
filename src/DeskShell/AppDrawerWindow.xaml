<Window x:Class="DeskShell.AppDrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskShell"
        Title="DeskShell Apps"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        Left="-20000" Top="-20000" Width="780" Height="720"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PlainRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One app: icon over name -->
        <DataTemplate x:Key="CellTemplate" DataType="{x:Type local:DrawerCell}">
            <Button Click="Cell_Click" ContextMenuOpening="Cell_ContextMenuOpening" ToolTip="{Binding Name}" Cursor="Hand"
                    Focusable="False" AutomationProperties.Name="{Binding Name}" Width="116" Height="92">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="2" Padding="6,8,6,4">
                            <StackPanel>
                                <Grid Width="36" Height="36">
                                    <TextBlock x:Name="Fallback" Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="20"
                                               Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed" />
                                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis" MaxHeight="32" Foreground="{DynamicResource TextBrush}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1CFFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <!-- With the notch: the black shape that grows out of it (and shrinks back), drawn behind the contents -->
    <Path x:Name="Morph" Fill="Black" Stroke="#24FFFFFF" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False" />
    <Border x:Name="Panel" Margin="14,0,14,24" Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandEdgeBrush}" BorderThickness="1"
            CornerRadius="28" Padding="18,18,18,14" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PanelScale" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Tag="Search apps" Margin="0,0,0,10"
                     AutomationProperties.Name="Search apps" TextChanged="SearchBox_TextChanged" />

            <!-- Quick links, then power -->
            <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <StackPanel x:Name="Links" Orientation="Horizontal">
                    <Button Style="{StaticResource PillButton}" Tag="&#xE8B7;" Content="Files" Margin="0,0,6,0" Click="Files_Click" />
                    <Button x:Name="SearchFilesButton" Style="{StaticResource PillButton}" Tag="&#xE721;" Content="Search files" Margin="0,0,6,0" Click="SearchFiles_Click"
                            ToolTip="Every file and folder on your drives, as you type (Alt+Enter searches files for what you typed)" />
                    <Button Style="{StaticResource PillButton}" Tag="&#xE896;" Content="Downloads" Margin="0,0,6,0" Click="Downloads_Click" />
                    <Button Style="{StaticResource PillButton}" Tag="&#xE8A5;" Content="Documents" Margin="0,0,6,0" Click="Documents_Click" />
                    <Button Style="{StaticResource PillButton}" Tag="&#xE713;" Content="Settings" Margin="0,0,6,0" Click="WindowsSettings_Click" />
                    <Button x:Name="ToolsButton" Style="{StaticResource PillButton}" Tag="&#xE756;" Content="Tools" Click="Tools_Click"
                            ToolTip="Command Prompt, PowerShell and system tools, also as administrator">
                        <Button.ContextMenu>
                            <ContextMenu />
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="PowerPrompt" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextDimBrush}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" ToolTip="Lock" AutomationProperties.Name="Lock" Click="Lock_Click">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="Sleep" AutomationProperties.Name="Sleep" Click="Sleep_Click">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE708;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="Restart" AutomationProperties.Name="Restart" Click="Restart_Click">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" />
                    </Button>
                    <Button Style="{StaticResource GhostButton}" ToolTip="Shut down" AutomationProperties.Name="Shut down" Click="Shutdown_Click">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid>
                <ListBox x:Name="Rows" Background="Transparent" BorderThickness="0" Focusable="False"
                         ItemContainerStyle="{StaticResource PlainRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type local:DrawerHeader}">
                            <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}" Margin="8,10,0,4" />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:DrawerRow}">
                            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource CellTemplate}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>
                <TextBlock x:Name="NoResults" Text="No apps match that" Visibility="Collapsed" FontSize="14" Margin="8,10,0,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource TextDimBrush}" />
            </Grid>
        </DockPanel>
    </Border>
    </Grid>
</Window>
