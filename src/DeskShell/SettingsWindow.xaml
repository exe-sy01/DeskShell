<Window x:Class="DeskShell.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskShell settings" Width="760" Height="860" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,28,0,4" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0" Padding="28,14">
            <Grid>
                <Button Style="{StaticResource PillButton}" Tag="&#xE8A5;" Content="Open settings file" HorizontalAlignment="Left" Click="OpenFile_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock x:Name="Status" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Style="{StaticResource PillButton}" Tag="&#xE711;" Content="Close" Margin="0,0,8,0" Click="Close_Click" />
                    <Button Style="{StaticResource AccentButton}" Tag="&#xE74E;" Content="Save" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,4,22,28">
            <StackPanel MaxWidth="680" HorizontalAlignment="Left">

                <TextBlock Style="{StaticResource Section}" Text="General" Margin="0,16,0,4" />
                <TextBlock Style="{StaticResource Note}" Text="Hotkeys are written like Alt+Space, Ctrl+Alt+Up or Win+Shift+S. A hotkey another app already uses won't work; DeskShell's log says which." />
                <CheckBox x:Name="StartWithWindows" Style="{StaticResource Switch}" Content="Start DeskShell when I sign in to Windows" Margin="0,4,0,10" />
                <CheckBox x:Name="WinKeyOpensDrawer" Style="{StaticResource Switch}" Content="Windows key opens the app drawer instead of the Start menu" Margin="0,0,0,10" />
                <CheckBox x:Name="UseDeskShellTaskManager" Style="{StaticResource Switch}" Margin="0,0,0,10"
                          Content="Use DeskShell's Task Manager for Ctrl+Shift+Esc (off: Windows' Task Manager)" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Open the shell" />
                    <TextBox x:Name="ShellHotkey" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Open the app drawer" />
                    <TextBox x:Name="AppDrawerHotkey" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Show all windows" />
                    <TextBox x:Name="OverviewHotkey" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Quit DeskShell" />
                    <TextBox x:Name="QuitHotkey" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="Install and updates" />
                <TextBlock x:Name="InstallNote" Style="{StaticResource Note}" />
                <Button x:Name="InstallButton" Style="{StaticResource PillButton}" Tag="&#xE896;" Content="Install DeskShell" HorizontalAlignment="Left"
                        Margin="0,0,0,10" Click="Install_Click" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Update from GitHub repo" ToolTip="owner/name, e.g. simon/deskshell. Its latest release needs a .zip of DeskShell attached." />
                    <TextBox x:Name="UpdateRepo" Grid.Column="1" Style="{StaticResource Field}" />
                    <Button Grid.Column="2" Style="{StaticResource PillButton}" Tag="&#xE72C;" Content="Check now" Margin="10,0,0,0" Click="CheckUpdates_Click" />
                </Grid>
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource Note}" Margin="0,4,0,0" />

                <TextBlock Style="{StaticResource Section}" Text="Games" />
                <TextBlock Style="{StaticResource Note}" Text="Game mode starts when something runs fullscreen: DeskShell hides, pauses its background checks and frees memory until you leave the game." />
                <CheckBox x:Name="GameModeOn" Style="{StaticResource Switch}" Content="Game mode" Margin="0,4,0,8" />
                <CheckBox x:Name="GameModeDnd" Style="{StaticResource Switch}" Content="Turn on Do Not Disturb during games (if it isn't on already)" Margin="0,4,0,4" />

                <TextBlock Style="{StaticResource Section}" Text="Island" />
                <TextBlock Style="{StaticResource Note}" Text="The pill at the top of the screen. ‹ › or the mouse wheel flip between notifications, music, open windows and pinned programs; double-click it to open the shell." />
                <CheckBox x:Name="ShowIsland" Style="{StaticResource Switch}" Margin="0,4,0,8" Content="Show the island" />
                <CheckBox x:Name="IslandOnAllMonitors" Style="{StaticResource Switch}" Margin="0,4,0,8" IsEnabled="{Binding IsChecked, ElementName=ShowIsland}"
                          Content="An island on every monitor, each showing its own windows (off: main monitor only)" />
                <CheckBox x:Name="IslandReserveSpace" Style="{StaticResource Switch}" Margin="0,4,0,8" IsEnabled="{Binding IsChecked, ElementName=ShowIsland}"
                          Content="Keep maximised windows below the island" />
                <CheckBox x:Name="IslandAppsButton" Style="{StaticResource Switch}" Margin="0,4,0,8" IsEnabled="{Binding IsChecked, ElementName=ShowIsland}"
                          Content="All-apps button on the island" />
                <CheckBox x:Name="IslandDiscordMessages" Style="{StaticResource Switch}" Margin="0,4,0,8" IsEnabled="{Binding IsChecked, ElementName=ShowIsland}"
                          Content="Show Discord DMs and mentions as notifications" />
                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,6"
                           Text="Its size, look, pages and animations are designed in Island Workshop: press &quot;Copy settings&quot; there, then paste them here." />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Style="{StaticResource PillButton}" Tag="&#xE77F;" Content="Paste from Island Workshop" Click="PasteIsland_Click" />
                    <TextBlock x:Name="IslandImportStatus" Style="{StaticResource Note}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="Windows taskbar" />
                <CheckBox x:Name="ShowWindowsTaskbar" Style="{StaticResource Switch}" Margin="0,4,0,8"
                          Content="Show the Windows taskbar, with the tray icons, alongside the island" />

                <TextBlock Style="{StaticResource Section}" Text="Dock" />
                <CheckBox x:Name="ShowDock" Style="{StaticResource Switch}" Margin="0,4,0,10"
                          Content="Show the dock at the bottom of the screen (the island replaces it)" />
                <CheckBox x:Name="DockOnAllMonitors" Style="{StaticResource Switch}" Margin="0,4,0,10" IsEnabled="{Binding IsChecked, ElementName=ShowDock}"
                          Content="A dock on every monitor, each showing its own windows" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Space reserved for the dock" />
                    <TextBox x:Name="DockHeight" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="Weather" />
                <TextBlock Style="{StaticResource Note}" Text="Type your city to see its weather. Weather comes from Open-Meteo; DeskShell never asks Windows for your location." />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="City" />
                    <TextBox x:Name="WeatherCity" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>
                <CheckBox x:Name="Fahrenheit" Style="{StaticResource Switch}" Content="Show temperatures in °F" Margin="0,8,0,0" />

                <TextBlock Style="{StaticResource Section}" Text="Windows" />
                <CheckBox x:Name="CustomAltTab" Style="{StaticResource Switch}" Margin="0,4,0,4"
                          Content="Use DeskShell's Alt+Tab (Windows' own is used during fullscreen games)" />
                <CheckBox x:Name="RestoreWindowPositions" Style="{StaticResource Switch}" Margin="0,8,0,4"
                          Content="Reopen apps where they were last time" />
                <CheckBox x:Name="ActiveWindowBorder" Style="{StaticResource Switch}" Margin="0,8,0,4"
                          Content="Colour the border of the window you're using" />
                <Grid Style="{StaticResource Row}" Margin="52,2,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="168" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Border colour" />
                    <TextBox x:Name="BorderColor" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="Snap zones" />
                <TextBlock Style="{StaticResource Note}" Text="Hold Shift while dragging a window, then drop it on a zone. Each monitor has its own layout." />
                <CheckBox x:Name="SnapZones" Style="{StaticResource Switch}" Content="Snap zones on" Margin="0,4,0,8" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Gap between windows (px)" />
                    <TextBox x:Name="ZoneGap" Grid.Column="1" Style="{StaticResource Field}" />
                </Grid>
                <StackPanel x:Name="MonitorLayouts" Margin="0,8,0,0" />

                <TextBlock Style="{StaticResource Section}" Text="App rules" />
                <TextBlock x:Name="RulesNote" Style="{StaticResource Note}" />
                <StackPanel x:Name="Rules" />
                <Button Style="{StaticResource PillButton}" Tag="&#xE710;" Content="Add rule" HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddRule_Click" />

                <TextBlock Style="{StaticResource Section}" Text="Shell tiles" />
                <TextBlock Style="{StaticResource Note}" Text="Use Customise in the shell to move, resize, add and remove tiles." />
                <Button Style="{StaticResource PillButton}" Tag="&#xE72C;" Content="Reset tiles to the default layout" HorizontalAlignment="Left" Click="ResetTiles_Click" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
