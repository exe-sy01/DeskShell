<Window x:Class="DeskShell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskShell"
        xmlns:tasks="clr-namespace:ManagedShell.WindowsTasks;assembly=ManagedShell.WindowsTasks"
        Title="DeskShell Island"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Left="-20000" Top="-20000" Width="468" Height="110"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <!-- Round, quiet buttons inside the pill (arrows, media controls) -->
        <Style x:Key="IslandButton" TargetType="ButtonBase">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An open window: its icon, a dot underneath for the one in use (and, if chosen, that one's title) -->
        <DataTemplate x:Key="IslandTaskTemplate" DataType="{x:Type tasks:ApplicationWindow}">
            <Button Command="{x:Static local:TaskCommands.Activate}" CommandParameter="{Binding}"
                    ToolTip="{Binding Title}" Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="1,0">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Pin" Command="{x:Static local:TaskCommands.PinToDock}" CommandParameter="{Binding}" />
                        <MenuItem Header="Minimise" Command="{x:Static local:TaskCommands.Minimize}" CommandParameter="{Binding}" />
                        <MenuItem Header="Close window" Command="{x:Static local:TaskCommands.Close}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="32">
                            <Border x:Name="Bg" CornerRadius="16" Background="Transparent" />
                            <StackPanel Orientation="Horizontal" Margin="7,0">
                                <Grid Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:IslandWindow}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:IslandWindow}}" VerticalAlignment="Center">
                                    <Image x:Name="Img" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Image Source="{Binding OverlayIcon}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                           Margin="0,0,-4,-3" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock x:Name="Name" Text="{Binding Title}" MaxWidth="130" Margin="7,0,2,0" FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />
                            </StackPanel>
                            <Ellipse x:Name="Dot" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                     Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding State}" Value="Active">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding State}" Value="Active" />
                                    <Condition Binding="{Binding ShowActiveTitle, RelativeSource={RelativeSource AncestorType=local:IslandWindow}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Name" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Flashing">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource FlashBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                                <Setter TargetName="Img" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- A pinned program, file or folder -->
        <DataTemplate x:Key="IslandPinTemplate">
            <Button Click="Pin_Click" ContextMenuOpening="Pin_ContextMenuOpening" ToolTip="{Binding Name}"
                    Cursor="Hand" FocusVisualStyle="{x:Null}" Margin="1,0">
                <Button.ContextMenu>
                    <ContextMenu />
                </Button.ContextMenu>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="32" Height="32">
                            <Border x:Name="Bg" CornerRadius="16" Background="Transparent" />
                            <TextBlock x:Name="Fallback" Style="{StaticResource Icon}" Text="&#xE8A5;" FontSize="15" Visibility="Collapsed" />
                            <Image x:Name="Img" Source="{Binding Icon}" Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:IslandWindow}}" Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=local:IslandWindow}}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Ellipse x:Name="Dot" Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                     Fill="{DynamicResource TextDimBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                <Setter TargetName="Fallback" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Shadow, separate from the pill so the pill's text stays crisp -->
        <Border x:Name="Shadow" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="Black" IsHitTestVisible="False" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="ShadowScale" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="ShadowEffect" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border x:Name="Pill" VerticalAlignment="Top" HorizontalAlignment="Center" ClipToBounds="True"
                Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandEdgeBrush}" BorderThickness="1"
                RenderTransformOrigin="0.5,0" AllowDrop="True"
                PreviewMouseLeftButtonDown="Pill_PreviewMouseLeftButtonDown" MouseLeftButtonUp="Pill_MouseLeftButtonUp" MouseWheel="Pill_MouseWheel"
                MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave" DragOver="Pill_DragOver" Drop="Pill_Drop">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" />
            </Border.RenderTransform>
            <Border.ContextMenu>
                <ContextMenu Opened="PillMenu_Opened" Closed="PillMenu_Closed">
                    <MenuItem Header="All apps" Click="Apps_Click" />
                    <MenuItem Header="Open the shell" Click="OpenShell_Click" />
                    <MenuItem Header="DeskShell settings" Click="Settings_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <!-- Normal contents: ‹ page › -->
                <Grid x:Name="Contents" Margin="5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AppsButton" Style="{StaticResource IslandButton}" Click="Apps_Click" ToolTip="All apps" AutomationProperties.Name="All apps">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="13" />
                        </Button>
                        <Button x:Name="PrevButton" Style="{StaticResource IslandButton}" Click="Prev_Click" AutomationProperties.Name="Previous page">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE76B;" FontSize="10" />
                        </Button>
                    </StackPanel>
                    <Grid Grid.Column="1" ClipToBounds="True" Margin="4,0">
                        <ContentControl x:Name="PageHost" Focusable="False" VerticalAlignment="Center">
                            <ContentControl.RenderTransform>
                                <TranslateTransform x:Name="PageShift" />
                            </ContentControl.RenderTransform>
                        </ContentControl>
                    </Grid>
                    <Button x:Name="NextButton" Grid.Column="2" Style="{StaticResource IslandButton}" Click="Next_Click" AutomationProperties.Name="Next page">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" />
                    </Button>
                </Grid>

                <!-- A moment: a new notification shown in full while the island is taller -->
                <Grid x:Name="Moment" Margin="14,0" Visibility="Collapsed" Opacity="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="MomentIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="MomentTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="MomentBody" FontSize="11.5" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextDimBrush}" />
                    </StackPanel>
                </Grid>

                <!-- While peeking in a call: the people talking right now -->
                <StackPanel x:Name="Speakers" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Opacity="0" IsHitTestVisible="False" />

                <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                            IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
