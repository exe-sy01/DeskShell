<Window x:Class="DeskShell.Search.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:DeskShell.Search"
        Title="Search files"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="False" ShowActivated="True"
        Width="1040" Height="660" MinWidth="560" MinHeight="320"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <!-- Resizable from its edges, inside the shadow margin -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="22" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- A result row, like the explorer's details rows -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Margin="0,1" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background"><Setter.Value><SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.2" /></Setter.Value></Setter>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColumnHeader" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.FontSize="12" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Kind" TargetType="RadioButton" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="GroupName" Value="Kind" />
        </Style>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type s:SearchRow}">
            <Grid Height="30" Background="Transparent" ToolTip="{Binding Path}" ToolTipService.InitialShowDelay="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <Grid Margin="12,0,8,0" Opacity="{Binding Faded}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="20" Height="20" Margin="0,0,10,0">
                        <TextBlock x:Name="Fallback" Style="{StaticResource Icon}" FontSize="14" Text="&#xE7C3;" Foreground="{DynamicResource TextDimBrush}" />
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Grid.Column="1" Text="{Binding Folder}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0"
                           FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0"
                           FontSize="12.5" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding ModifiedText}" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,16,0"
                           FontSize="12.5" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="Fallback" Property="Text" Value="&#xE8B7;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!-- The shadow margin is almost (not fully) transparent, so it catches the mouse for resizing -->
    <Grid Background="#01000000">
    <Grid Margin="22">
        <Border x:Name="Panel" Background="{DynamicResource IslandBrush}" BorderBrush="{DynamicResource IslandEdgeBrush}" BorderThickness="1"
                CornerRadius="26" Padding="18,16,18,12" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PanelScale" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <!-- The box; the strip around it drags the window -->
                <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search every file and folder" Height="40" FontSize="15"
                             AutomationProperties.Name="Search files" TextChanged="SearchBox_TextChanged" />
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="0,10,0,6" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="KindAll" Style="{StaticResource Kind}" Content="Everything" IsChecked="True" Checked="Kind_Checked" />
                        <RadioButton x:Name="KindFiles" Style="{StaticResource Kind}" Content="Files" Checked="Kind_Checked" />
                        <RadioButton x:Name="KindFolders" Style="{StaticResource Kind}" Content="Folders" Checked="Kind_Checked" />
                    </StackPanel>
                    <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextDimBrush}" />
                </Grid>

                <!-- Column headers: click to sort, again to reverse -->
                <Grid DockPanel.Dock="Top" Margin="0,0,6,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource ColumnHeader}" Tag="Name" Click="Header_Click" AutomationProperties.Name="Sort by name">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Name" Margin="22,0,0,0" /><TextBlock x:Name="ArrowName" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource ColumnHeader}" Tag="Folder" Click="Header_Click" AutomationProperties.Name="Sort by folder">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Folder" /><TextBlock x:Name="ArrowFolder" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource ColumnHeader}" Tag="Size" Click="Header_Click" HorizontalContentAlignment="Right" AutomationProperties.Name="Sort by size">
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="ArrowSize" Style="{StaticResource Icon}" FontSize="9" Margin="0,0,6,0" /><TextBlock Text="Size" /></StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource ColumnHeader}" Tag="Modified" Click="Header_Click" AutomationProperties.Name="Sort by date modified">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="Modified" /><TextBlock x:Name="ArrowModified" Style="{StaticResource Icon}" FontSize="9" Margin="6,0,0,0" /></StackPanel>
                    </Button>
                </Grid>

                <!-- Footer: what's indexed, and the keys -->
                <Grid DockPanel.Dock="Bottom" Margin="4,8,4,0">
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,320,0" />
                    <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                               Text="Enter open  ·  Ctrl+Enter show in folder  ·  Ctrl+Shift+C copy path" />
                </Grid>

                <Grid>
                    <ListBox x:Name="List" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource RowTemplate}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                             MouseDoubleClick="List_MouseDoubleClick" ContextMenuOpening="List_ContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- Before typing: how to search -->
                    <StackPanel x:Name="Help" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="Type any part of a name. Results appear as you type." HorizontalAlignment="Center" FontSize="14" Margin="0,0,0,14" />
                        <Grid HorizontalAlignment="Center">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Margin" Value="0,2,18,2" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="tax 2025" Foreground="{DynamicResource TextBrush}" /><TextBlock Grid.Row="0" Grid.Column="1" Text="names with both words, in any order" />
                            <TextBlock Grid.Row="1" Text="*.log    report??.docx" Foreground="{DynamicResource TextBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="wildcards, against the whole name" />
                            <TextBlock Grid.Row="2" Text="ext:jpg;png" Foreground="{DynamicResource TextBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="by extension" />
                            <TextBlock Grid.Row="3" Text="&quot;two words&quot;    !draft    jpg|png" Foreground="{DynamicResource TextBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="a phrase, leave out, either" />
                            <TextBlock Grid.Row="4" Text="projects\ readme" Foreground="{DynamicResource TextBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="with a \ it looks at the whole path" />
                            <TextBlock Grid.Row="5" Text="file:    folder:" Foreground="{DynamicResource TextBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="only files, or only folders" />
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="NoResults" Text="Nothing matches that" Visibility="Collapsed" FontSize="14" Margin="12,10,0,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource TextDimBrush}" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
